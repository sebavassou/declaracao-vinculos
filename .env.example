# Copie para .env e ajuste. Nunca versione o .env.

# --- Integração (pipelines e dashboards) ---
DV_API_TOKEN=gere-com: python -c "import secrets;print(secrets.token_urlsafe(32))"
DV_CORS_ORIGINS=

# --- Armazenamento ---
DV_DB_PATH=/dados/declaracoes.sqlite3

# --- Autenticação: none (só intranet) | proxy (login institucional no proxy reverso) ---
DV_AUTH_MODE=none
DV_AUTH_HEADER_USER=X-Remote-User
DV_AUTH_HEADER_NAME=X-Remote-Name
DV_AUTH_HEADER_EMAIL=X-Remote-Email
# Logins da equipe de GP que podem abrir o espelho de qualquer protocolo (separados por vírgula)
DV_ADMINS=

# --- Identidade da unidade (textos do formulário e do PDF) ---
DV_CABECALHO_1=Ministério da Saúde · Secretaria de Atenção Especializada à Saúde
DV_CABECALHO_2=Instituto Nacional de Traumatologia e Ortopedia · Coordenação de Administração de Pessoas
DV_ORGAO_SIGLA=INTO
DV_ORGAO_TITULO=INTO – Instituto Nacional de Traumatologia e Ortopedia
DV_ORGAO_NOME=Instituto Nacional de Traumatologia e Ortopedia (INTO/MS)
DV_UNIDADE_GP=COAPE/INTO
DV_CIDADE_UF=Rio de Janeiro/RJ
